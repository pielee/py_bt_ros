<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

  <BehaviorTree ID="limo_delivery_tree">

    <!-- ================================================= -->
    <!-- TOP: 항상 반응 -->
    <!-- ================================================= -->
    <ReactiveFallback>

      <!-- ============================================= -->
      <!-- 📦 택배가 있는 경우 -->
      <!-- ============================================= -->
      <Sequence>

        <!-- 택배 존재 조건 -->
        <ParcelAvailable/>

        <!-- =============================== -->
        <!-- PICKUP (대기 포함) -->
        <!-- =============================== -->
        <ReactiveFallback>

          <!-- 다른 로봇이 수령 중이면 대기 -->
          <Sequence>
            <OtherRobotReceiving/>
            <MoveToWaiting/>
          </Sequence>

          <!-- 아니면 픽업 -->
          <MoveToPickup/>

        </ReactiveFallback>

        <!-- 수령 -->
        <RetryUntilSuccessful num_attempts="60">
          <ReceiveParcel/>
        </RetryUntilSuccessful>

        <!-- QR 탐색 -->
        <Timeout duration="10.0">
          <WaitForQRPose/>
        </Timeout>

        <!-- =============================== -->
        <!-- DELIVERY (대기 포함) -->
        <!-- =============================== -->
        <ReactiveFallback>

          <!-- 다른 로봇이 배송 중이면 대기 -->
          <Sequence>
            <OtherRobotDropping/>
            <MoveToWaiting/>
          </Sequence>

          <!-- 아니면 배송 -->
          <MoveToDelivery/>

        </ReactiveFallback>

        <!-- 하차 -->
        <RetryUntilSuccessful num_attempts="60">
          <DropoffParcel/>
        </RetryUntilSuccessful>

      </Sequence>

      <!-- ============================================= -->
      <!-- 🔋 택배 없으면 충전 -->
      <!-- ============================================= -->
      <MoveToCharge/>

    </ReactiveFallback>

  </BehaviorTree>

  <!-- ================================================= -->
  <!-- NODE MODEL -->
  <!-- ================================================= -->
  <TreeNodesModel>

    <!-- Actions -->
    <Action ID="MoveToPickup"/>
    <Action ID="MoveToDelivery"/>
    <Action ID="MoveToWaiting"/>
    <Action ID="MoveToCharge"/>
    <Action ID="WaitForQRPose"/>

    <!-- Conditions -->
    <Condition ID="ParcelAvailable"/>
    <Condition ID="ReceiveParcel"/>
    <Condition ID="DropoffParcel"/>
    <Condition ID="OtherRobotReceiving"/>
    <Condition ID="OtherRobotDropping"/>

    <!-- Control -->
    <Control ID="ReactiveFallback"/>

    <!-- Decorators -->
    <Decorator ID="RetryUntilSuccessful">
      <input_port name="num_attempts" type="int" default="1"/>
    </Decorator>

    <Decorator ID="Timeout">
      <input_port name="duration" type="float" default="10.0"/>
    </Decorator>

  </TreeNodesModel>

</root>
