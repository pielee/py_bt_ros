<?xml version="1.0" encoding="UTF-8"?>
<root main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">

    <Sequence>

      <!-- 반복: 수령 → QR → 배달 -->
      <RepeatUntilFailure>
        <Sequence>

          <!-- 1) 수령소 이동 -->
          <SetGoal mode="pickup"/>
          <MoveToGoal/>

          <!-- 2) 택배 수령 (QR 스캔 포함) -->
          <ReceiveParcel/>

          <!-- 3) 택배가 없으면 루프 종료 -->
          <HasParcel/>

          <!-- 4) QR 목적지 이동 -->
          <SetGoal mode="qr"/>
          <MoveToGoal/>

          <!-- 5) 배달 -->
          <DropoffParcel/>

        </Sequence>
      </RepeatUntilFailure>

      <!-- 루프 종료(택배 없음) → 충전소 이동 -->
      <SetGoal mode="charge"/>
      <MoveToGoal/>

    </Sequence>

  </BehaviorTree>

</root>
