<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

  <BehaviorTree ID="limo_delivery_tree">

    <Sequence>

      <!-- ================================================= -->
      <!-- 1. MOVE TO PICKUP (REACTIVE IF) -->
      <!-- ================================================= -->
      <ReactiveFallback>

        <!-- IF other robot is receiving -->
        <Sequence>
          <OtherRobotReceiving/>
          <MoveToWaiting/>
        </Sequence>

        <!-- ELSE -->
        <MoveToPickup/>

      </ReactiveFallback>

      <!-- ================================================= -->
      <!-- 2. QR / DELIVERY OR CHARGE -->
      <!-- ================================================= -->
      <Fallback>

        <!-- ================= SUCCESS PATH ================= -->
        <Sequence>

          <!-- QR SEARCH (TIMEOUT) -->
          <Timeout duration="10.0">
            <WaitForQRPose/>
          </Timeout>

          <!-- RECEIVE PARCEL -->
          <RetryUntilSuccessful num_attempts="60">
            <ReceiveParcel/>
          </RetryUntilSuccessful>

          <!-- MOVE TO DELIVERY (REACTIVE IF) -->
          <ReactiveFallback>

            <Sequence>
              <OtherRobotDropping/>
              <MoveToWaiting/>
            </Sequence>

            <MoveToDelivery/>

          </ReactiveFallback>

          <!-- DROPOFF -->
          <RetryUntilSuccessful num_attempts="60">
            <DropoffParcel/>
          </RetryUntilSuccessful>

          <!-- SUCCESS → RETURN -->
          <MoveToCharge/>

        </Sequence>

        <!-- ================= FAILURE PATH ================= -->
        <!-- QR TIMEOUT FAILS → GO CHARGE -->
        <MoveToCharge/>

      </Fallback>

    </Sequence>

  </BehaviorTree>

  <!-- ================================================= -->
  <!-- NODE MODEL -->
  <!-- ================================================= -->
  <TreeNodesModel>

    <!-- Actions -->
    <Action ID="MoveToPickup"/>
    <Action ID="MoveToDelivery"/>
    <Action ID="MoveToWaiting"/>
    <Action ID="MoveToCharge"/>
    <Action ID="WaitForQRPose"/>

    <!-- Conditions -->
    <Condition ID="ReceiveParcel"/>
    <Condition ID="DropoffParcel"/>
    <Condition ID="OtherRobotReceiving"/>
    <Condition ID="OtherRobotDropping"/>

    <!-- Controls -->
    <Control ID="ReactiveFallback"/>

    <!-- Decorators -->
    <Decorator ID="RetryUntilSuccessful">
      <input_port name="num_attempts" type="int" default="1"/>
    </Decorator>

    <Decorator ID="Timeout">
      <input_port name="duration" type="float" default="10.0"/>
    </Decorator>

  </TreeNodesModel>

</root>
