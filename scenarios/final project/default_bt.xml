<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

  <BehaviorTree ID="limo_delivery_tree">
    <Sequence>

      <!-- =============================================== -->
      <!-- 1. MOVE TO PICKUP (STATEFUL + REACTIVE IF) -->
      <!-- =============================================== -->
      <Fallback>

        <!-- 이미 도착했으면 통과 -->
        <AtPickupLocation/>

        <!-- 아직 안 도착 -->
        <Fallback>

          <!-- IF other robot busy -->
          <Sequence>
            <OtherRobotReceiving/>
            <MoveToWaiting/>
          </Sequence>

          <!-- ELSE -->
          <MoveToPickup/>

        </Fallback>
      </Fallback>

      <!-- =============================================== -->
      <!-- 2. RECEIVE PARCEL -->
      <!-- =============================================== -->
      <RetryUntilSuccessful num_attempts="60">
        <ReceiveParcel/>
      </RetryUntilSuccessful>

      <!-- =============================================== -->
      <!-- 3. QR SEARCH -->
      <!-- =============================================== -->
      <Timeout duration="10.0">
        <WaitForQRPose/>
      </Timeout>

      <!-- =============================================== -->
      <!-- 4. MOVE TO DELIVERY (STATEFUL + REACTIVE IF) -->
      <!-- =============================================== -->
      <Fallback>

        <AtDeliveryLocation/>

        <Fallback>

          <Sequence>
            <OtherRobotDropping/>
            <MoveToWaiting/>
          </Sequence>

          <MoveToDelivery/>

        </Fallback>
      </Fallback>

      <!-- =============================================== -->
      <!-- 5. DROPOFF -->
      <!-- =============================================== -->
      <RetryUntilSuccessful num_attempts="60">
        <DropoffParcel/>
      </RetryUntilSuccessful>

      <!-- =============================================== -->
      <!-- 6. RETURN -->
      <!-- =============================================== -->
      <MoveToCharge/>

    </Sequence>
  </BehaviorTree>

  <!-- =============================================== -->
  <!-- NODE MODEL -->
  <!-- =============================================== -->
  <TreeNodesModel>

    <!-- Actions -->
    <Action ID="MoveToPickup"/>
    <Action ID="MoveToDelivery"/>
    <Action ID="MoveToWaiting"/>
    <Action ID="MoveToCharge"/>
    <Action ID="WaitForQRPose"/>

    <!-- Conditions -->
    <Condition ID="AtPickupLocation"/>
    <Condition ID="AtDeliveryLocation"/>
    <Condition ID="ReceiveParcel"/>
    <Condition ID="DropoffParcel"/>
    <Condition ID="OtherRobotReceiving"/>
    <Condition ID="OtherRobotDropping"/>

    <!-- Decorators -->
    <Decorator ID="RetryUntilSuccessful">
      <input_port name="num_attempts" type="int"/>
    </Decorator>

    <Decorator ID="Timeout">
      <input_port name="duration" type="float"/>
    </Decorator>

  </TreeNodesModel>

</root>
